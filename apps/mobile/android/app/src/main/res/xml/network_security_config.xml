<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV panels are frequently plain HTTP; allow cleartext for all domains including our custom DNS proxy loopback. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
